{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/webhook.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/admin/users/:action_id/status",
      "destination": "/api/admin/user-status"
    },
    {
      "source": "/",
      "destination": "/api/webhook"
    },
    {
      "source": "/webhook",
      "destination": "/api/webhook"
    }
  ]
}
